# Global API Key Template
# Copy this to your profile's .env or the global .env (if allowed) and fill in the values.

# NVIDIA (for Nemotron models)
NVIDIA_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# AnySearch (for web search)
ANYSEARCH_API_KEY=

# OpenCode Zen
OPENCODE_ZEN_API_KEY=

# Agnes (custom provider)
AGNES_API_KEY=

# Add other keys as needed
# EXAMPLE_API_KEY=